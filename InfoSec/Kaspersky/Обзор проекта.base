filters:
  and:
    - file.ext == "md"
    - file.inFolder("InfoSec/Kaspersky")
properties:
  topic:
    displayName: Тема
  status:
    displayName: Статус
views:
  - type: table
    name: Все заметки
    order:
      - file.name
      - topic
      - status
    sort:
      - property: topic
        direction: ASC
      - property: status
        direction: ASC
  - type: table
    name: По темам
    groupBy:
      property: topic
      direction: ASC
    order:
      - file.name
      - status
  - type: table
    name: Черновики (доработать)
    filters:
      and:
        - status == "draft"
    order:
      - file.name
      - topic
