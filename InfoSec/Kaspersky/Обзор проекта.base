filters:
  and:
    - 'file.ext == "md"'
    - 'file.inFolder("InfoSec/Kaspersky")'

properties:
  topic:
    displayName: Тема
  status:
    displayName: Статус

views:
  - type: table
    name: Все заметки
    order:
      - file.name
      - topic
      - status
  - type: table
    name: По темам
    order:
      - file.name
      - status
    groupBy:
      property: topic
      direction: ASC
  - type: table
    name: Черновики (доработать)
    filters:
      and:
        - 'status == "draft"'
    order:
      - file.name
      - topic
